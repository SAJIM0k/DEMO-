# Django Secret Key (Generate a random 50-character string for production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Debug Mode (False in production)
DEBUG=False

# Allowed Hosts (comma-separated, e.g., cambridge.sellvy.online,your-app.up.railway.app or * for all)
ALLOWED_HOSTS=cambridge.sellvy.online,*

# CSRF Trusted Origins (comma-separated)
CSRF_TRUSTED_ORIGINS=https://cambridge.sellvy.online,https://*.railway.app,https://*.up.railway.app

# Database URL (Provided automatically if you add PostgreSQL in Railway, falls back to SQLite if omitted)
# DATABASE_URL=postgresql://postgres:password@host:port/railway
