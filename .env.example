# Django Secret Key (Generate a random 50-character string for production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Debug Mode (False in production)
DEBUG=False

# Allowed Hosts (comma-separated, e.g., your-app.up.railway.app,customdomain.com or * for all)
ALLOWED_HOSTS=*

# CSRF Trusted Origins (comma-separated, e.g., https://your-app.up.railway.app,https://yourdomain.com)
CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://*.up.railway.app

# Database URL (Provided automatically if you add PostgreSQL in Railway, falls back to SQLite if omitted)
# DATABASE_URL=postgresql://postgres:password@host:port/railway
